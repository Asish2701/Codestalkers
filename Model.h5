import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout
from tensorflow.keras.preprocessing.image import ImageDataGenerator
import matplotlib.pyplot as plt

# Define the image dimensions and batch size
IMAGE_SIZE = (128, 128)
BATCH_SIZE = 32
NUM_CLASSES = 38 # Example: a dataset with 37 diseases + 1 healthy class

# --- 1. Data Preparation and Augmentation ---
# Create data generators for training and validation.
# Data augmentation helps prevent overfitting and improves model generalization.
train_datagen = ImageDataGenerator(
    rescale=1./255,        # Normalize pixel values to 0-1
    rotation_range=20,     # Rotate images randomly
    width_shift_range=0.2, # Shift images horizontally
    height_shift_range=0.2,# Shift images vertically
    shear_range=0.2,       # Shear transformations
    zoom_range=0.2,        # Randomly zoom in on images
    horizontal_flip=True,  # Flip images horizontally
    fill_mode='nearest'    # Fill newly created pixels
)

# For validation data, we only need to normalize the pixels
validation_datagen = ImageDataGenerator(rescale=1./255)

# Load images from a directory structure (e.g., train/ and validation/ folders)
train_generator = train_datagen.flow_from_directory(
    'path/to/your/train/dataset', # Replace with your dataset path
    target_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE,
    class_mode='categorical' # 'categorical' for multi-class classification
)

validation_generator = validation_datagen.flow_from_directory(
    'path/to/your/validation/dataset', # Replace with your dataset path
    target_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE,
    class_mode='categorical'
)

# --- 2. Build the CNN Model ---
# Sequential model is a linear stack of layers
model = Sequential([
    # Convolutional Block 1
    Conv2D(32, (3, 3), activation='relu', input_shape=(IMAGE_SIZE[0], IMAGE_SIZE[1], 3)),
    MaxPooling2D((2, 2)),
    
    # Convolutional Block 2
    Conv2D(64, (3, 3), activation='relu'),
    MaxPooling2D((2, 2)),
    
    # Convolutional Block 3
    Conv2D(128, (3, 3), activation='relu'),
    MaxPooling2D((2, 2)),
    
    # Flatten the 3D output to 1D for the dense layers
    Flatten(),
    
    # Fully Connected (Dense) Layers
    Dense(512, activation='relu'),
    Dropout(0.5), # Dropout helps prevent overfitting
    Dense(NUM_CLASSES, activation='softmax') # Output layer for classification
])

# --- 3. Compile the Model ---
# Use the Adam optimizer and categorical crossentropy for multi-class classification
model.compile(optimizer='adam',
              loss='categorical_crossentropy',
              metrics=['accuracy'])

# Display the model architecture
model.summary()

# --- 4. Train the Model ---
# This step will train the model on the training data and validate it on the validation data.
history = model.fit(
    train_generator,
    epochs=15, # Number of times to iterate over the entire dataset
    validation_data=validation_generator
)

# --- 5. Evaluate and Visualize Results ---
# Plot training and validation accuracy and loss over time
acc = history.history['accuracy']
val_acc = history.history['val_accuracy']
loss = history.history['loss']
val_loss = history.history['val_loss']

epochs_range = range(len(acc))

plt.figure(figsize=(12, 6))
plt.subplot(1, 2, 1)
plt.plot(epochs_range, acc, label='Training Accuracy')
plt.plot(epochs_range, val_acc, label='Validation Accuracy')
plt.legend(loc='lower right')
plt.title('Training and Validation Accuracy')

plt.subplot(1, 2, 2)
plt.plot(epochs_range, loss, label='Training Loss')
plt.plot(epochs_range, val_loss, label='Validation Loss')
plt.legend(loc='upper right')
plt.title('Training and Validation Loss')
plt.show()

# --- 6. Save the Trained Model ---
model.save('plant_disease_model.h5')
print("Model saved successfully!")
